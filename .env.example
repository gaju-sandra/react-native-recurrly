EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Server-only (used by app/api routes; never prefix with EXPO_PUBLIC_)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
RESEND_API_KEY=re_your_resend_api_key
# Optional. Resend's test sender only delivers to your own Resend account email;
# verify a domain at resend.com/domains to email any user, e.g. Recurly <reminders@yourdomain.com>
EMAIL_FROM=Recurly <onboarding@resend.dev>
